{
  "name": "vadasz_denes_vol2",
  "main": "main.js",
  "description": "Vadász Dénes program",
  "author": {
    "name": "SzigMakik"
  },
  "version": "1.1.0",
  "private": true,
  "//": [
    "WARNING The sign script can only be executed with admin privilege",
    "WARNING The openssl script can only be executed in the OpenSSL CMD" 
  ],
  "scripts": {
    "package": "electron-builder -w --x64",
    "sign":"electron-builder create-self-signed-cert -p Szigmakik_no_password",
    "openssl":"openssl pkcs12 -in Szigmakik_no_password.pfx -out temp.pem -nodes && openssl pkcs12 -export -in temp.pem -out Szigmakik.pfx -password pass:VadaszDenes && del temp.pem && del Szigmakik_no_password.pfx"
  },
  "dependencies": {
    "express": "^5.2.1"
  },
  "devDependencies": {
    "@types/node": "^20",
    "electron": "^40.6.1",
    "electron-builder": "^26.8.1"
  },
  "build": {
    "appId": "vadasz.denes.szigmakik",
    "directories": {
      "output": "../electron-builded"
    },
    "productName": "Vadász Dénes",
    "compression": "maximum",
    "electronLanguages": "hu",
    "copyright": "Copyright © 2026 SzigMakik",
    "icon": "./favicon.ico",
    "publish": {
      "provider": "github",
      "owner": "PasioteStudio",
      "releaseType": "release",
      "repo": "vadasz_denes_vol2"
    },
    "asar": true,
    "win": {
      "signtoolOptions":{
        "certificateFile": "./Szigmakik.pfx",
        "certificatePassword": "VadaszDenes"
      }
    }
  }
}


